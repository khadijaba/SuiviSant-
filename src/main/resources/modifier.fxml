<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" spacing="10" padding="10"
      fx:controller="controllers.modifierRController">
    <TextField fx:id="titreField" promptText="Titre"/>
    <TextArea fx:id="contenuArea" promptText="Contenu"/>
    <TextField fx:id="auteurField" promptText="Auteur"/>
    <TextField fx:id="imageField" promptText="Image URL"/>
    <TextField fx:id="videoField" promptText="Vidéo URL"/>
    <DatePicker fx:id="datePublicationPicker"/>
    <ComboBox fx:id="categorieComboBox"/>
    <Button text="Modifier" onAction="#modifierRessource"/>
</VBox>
