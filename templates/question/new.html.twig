{% extends 'base.html.twig' %}

{% block title %}Poser une question{% endblock %}

{% block body %}
    {{ block('header') }} {# Inclure le bloc header du template parent #}

    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-lg">
                    <div class="card-header bg-primary text-white py-4">
                        <h1 class="h4 mb-0">Poser une question</h1>
                    </div>
                    <div class="card-body p-4">
                        {# Inclure le template du formulaire #}
                        {{ include('question/_form.html.twig') }}
                    </div>
                    <div class="card-footer bg-light py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <a href="{{ path('app_question_index') }}" class="btn btn-outline-secondary btn-sm">
                                <i class="fas fa-arrow-left me-2"></i> Retour à la liste
                            </a>
                          
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{ block('footer') }} {# Inclure le bloc footer du template parent #}
{% endblock %}