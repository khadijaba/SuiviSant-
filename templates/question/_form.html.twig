{{ form_start(form, {'attr': {'id': 'question-form', 'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
    <div class="mb-4">
        {{ form_label(form.body, 'Votre question', {'label_attr': {'class': 'form-label fw-bold'}}) }}

        {# Add conditional class to input field for invalid state and display error message #}
        {{ form_widget(form.body, {
            'attr': {
                'class': 'form-control ' ~ (form.body.vars.errors|length > 0 ? 'is-invalid' : ''),
                'rows': 6,
                'placeholder': 'Tapez votre question ici...',
                'required': 'required'
            }
        }) }}

        {# Show error message in red #}
        <div class="invalid-feedback">
            {{ form_errors(form.body) }}
        </div>
        <small class="form-text text-muted">
            Soyez aussi précis que possible pour obtenir les meilleures réponses.
        </small>
    </div>

    <div class="mb-4">
        {{ form_label(form.ownerid, 'ID de l\'utilisateur', {'label_attr': {'class': 'form-label fw-bold'}}) }}

        {# Add conditional class to input field for invalid state and display error message #}
        {{ form_widget(form.ownerid, {
            'attr': {
                'class': 'form-control ' ~ (form.ownerid.vars.errors|length > 0 ? 'is-invalid' : ''),
                'placeholder': 'Entrez votre ID utilisateur...',
                'required': 'required'
            }
        }) }}

        {# Show error message in red #}
        <div class="invalid-feedback">
            {{ form_errors(form.ownerid) }}
        </div>
        <small class="form-text text-muted">
            Ceci est l'ID de l'utilisateur qui pose la question.
        </small>
    </div>

    <div class="d-flex justify-content-end">
        <button type="submit" class="btn btn-primary btn-sm">
            <i class="fas fa-save me-2"></i> {{ button_label|default('Enregistrer') }}
        </button>
    </div>

{{ form_end(form) }}
