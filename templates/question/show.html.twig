{% extends 'base.html.twig' %}

{% block title %}{{ question.title }} - Bien-Être+{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .question-detail-container {
        padding-top: 100px;
        min-height: 100vh;
        background-color: #f8f9fa;
    }
    .question-detail-card {
        border: none;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        border-radius: 10px;
        margin-bottom: 30px;
    }
    .answer-card {
        border-left: 4px solid #d0d0d0;
        margin-bottom: 20px;
    }
    .answer-card.accepted {
        border-left-color: #28a745;
    }
    .answer-badge {
        background-color: #e9f7fe;
        color: #0d6efd;
        border: 1px solid #c5e3f9;
        font-size: 0.85rem;
        padding: 5px 12px;
        border-radius: 50px;
    }
    .vote-controls {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 40px;
    }
</style>
{% endblock %}

{% block body %}
<nav class="navbar navbar-expand-lg bg-light fixed-top shadow-lg">
    <div class="container">
        <!-- Mobile Brand -->
        <a class="navbar-brand mx-auto d-lg-none" href="{{ path('app_home') }}">
            Bien-Être+
            <strong class="d-block">Health and Well-being</strong>
        </a>

        <!-- Navbar Toggler for Mobile -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" 
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar Links -->
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav mx-auto">
                <li class="nav-item {% if app.request.get('_route') == 'app_home' %}active{% endif %}">
                    <a class="nav-link" href="{{ path('app_home') }}">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#about">About</a>
                </li>

                <!-- Centered Brand for Large Screens -->
                <a class="navbar-brand d-none d-lg-block" href="{{ path('app_home') }}">
                    Bien-Être+
                    <strong class="d-block">Health and Well-being</strong>
                </a>

                <li class="nav-item">
                    <a class="nav-link" href="#reviews">Experts</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#timeline">Timeline</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="question-detail-container">
    <div class="container py-5">
        <!-- Flash messages -->
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} alert-dismissible fade show mb-4" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_forum_index') }}">Forum</a></li>
                {% if question.category %}
                    <li class="breadcrumb-item"><a href="{{ path('app_forum_index', {'category': question.category}) }}">{{ question.category }}</a></li>
                {% endif %}
                <li class="breadcrumb-item active" aria-current="page">{{ question.title|length > 30 ? question.title|slice(0, 30) ~ '...' : question.title }}</li>
            </ol>
        </nav>

        <div class="row">
            <div class="col-lg-9">
                <!-- Question Card -->
                <div class="card question-detail-card mb-4">
                    <div class="card-header bg-light">
                        <h1 class="h3">{{ question.title }}</h1>
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                {% if question.category %}
                                    <span class="answer-badge me-2">
                                        <i class="bi bi-tag me-1"></i>{{ question.category }}
                                    </span>
                                {% endif %}
                                <small>Posted by <strong>{{ question.authorName }}</strong> on {{ question.createdAt|date('d/m/Y H:i') }}</small>
                            </div>
                            <span class="badge bg-secondary rounded-pill">
                                <i class="bi bi-eye me-1"></i>{{ question.views }} views
                            </span>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="mb-4">
                            {{ question.content|nl2br }}
                        </div>
                        
                        <div class="d-flex justify-content-between">
                            <a href="{{ path('app_forum_index') }}" class="btn btn-outline-primary"><i class="bi bi-arrow-left me-1"></i> Back to forum</a>
                            <div>
                                <a href="{{ path('app_question_edit', {'id': question.id}) }}" class="btn btn-primary"><i class="bi bi-pencil me-1"></i> Edit</a>
                                <form action="{{ path('app_question_delete', {'id': question.id}) }}" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this question?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ question.id) }}">
                                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Answers Section -->
                <h2 class="h4 mb-3"><i class="bi bi-chat-left-text me-2"></i>{{ answers|length }} Answer{{ answers|length != 1 ? 's' : '' }}</h2>
                
                {% if answers|length > 0 %}
                    {% for answer in answers %}
                        <div class="card answer-card {{ answer.isAccepted ? 'accepted' : '' }} mb-3">
                            <div class="card-body">
                                <div class="d-flex">
                                    <!-- Vote controls -->
                                    <div class="vote-controls me-3">
                                        <form action="{{ path('app_answer_vote', {'id': answer.id, 'direction': 'up'}) }}" method="post">
                                            <input type="hidden" name="_token" value="{{ csrf_token('vote' ~ answer.id) }}">
                                            <button type="submit" class="btn btn-link p-0"><i class="bi bi-caret-up-fill"></i></button>
                                        </form>
                                        <div class="text-center fw-bold">{{ answer.votes }}</div>
                                        <form action="{{ path('app_answer_vote', {'id': answer.id, 'direction': 'down'}) }}" method="post">
                                            <input type="hidden" name="_token" value="{{ csrf_token('vote' ~ answer.id) }}">
                                            <button type="submit" class="btn btn-link p-0"><i class="bi bi-caret-down-fill"></i></button>
                                        </form>
                                    </div>
                                    <!-- Answer content -->
                                    <div class="flex-grow-1">
                                        <p>{{ answer.content|nl2br }}</p>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <small>Answered by <strong>{{ answer.authorName }}</strong> on {{ answer.createdAt|date('d/m/Y H:i') }}</small>
                                            {% if answer.isAccepted %}
                                                <span class="badge bg-success ms-2">Accepted Answer</span>
                                            {% endif %}
                                        </div>
                                        <div class="mt-2">
                                            {% if not answer.isAccepted %}
                                                <form action="{{ path('app_answer_accept', {'id': answer.id}) }}" method="post" style="display: inline;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('accept' ~ answer.id) }}">
                                                    <button type="submit" class="btn btn-outline-success btn-sm"><i class="bi bi-check-circle me-1"></i>Accept</button>
                                                </form>
                                            {% endif %}
                                            <a href="{{ path('app_answer_edit', {'id': answer.id}) }}" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i>Edit</a>
                                            <form action="{{ path('app_answer_delete', {'id': answer.id}) }}" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this answer?')">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ answer.id) }}">
                                                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash me-1"></i>Delete</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>No answers yet. Be the first to respond!
                    </div>
                {% endif %}

                <!-- Answer Form -->
                <div class="card mt-4">
                    <div class="card-header bg-primary text-white">
                        <h3 class="h5 mb-0"><i class="bi bi-reply-fill me-2"></i>Your Answer</h3>
                    </div>
                    <div class="card-body">
                        {{ form_start(answer_form) }}
                            {{ form_row(answer_form.content, {
                                'label': 'Your Answer',
                                'attr': {'rows': 6, 'placeholder': 'Write your answer here...'}
                            }) }}
                            {{ form_row(answer_form.authorName, {
                                'label': 'Your Name',
                                'attr': {'placeholder': 'Enter your name'}
                            }) }}
                            {{ form_row(answer_form.authorEmail, {
                                'label': 'Your Email (optional)',
                                'attr': {'placeholder': 'Enter your email'}
                            }) }}
                            <button type="submit" class="btn btn-primary"><i class="bi bi-send me-1"></i>Submit Answer</button>
                        {{ form_end(answer_form) }}
                    </div>
                </div>
            </div>
            
            <div class="col-lg-3">
                <!-- Sidebar -->
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Related Questions</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">Feature coming soon...</p>
                    </div>
                </div>
                
                <a href="{{ path('app_forum_index') }}" class="btn btn-outline-primary w-100">
                    <i class="bi bi-arrow-left me-2"></i>Back to Forum
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}