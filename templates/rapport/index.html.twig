{% extends 'base.html.twig' %}

{% block title %}Rapport index{% endblock %}

{% block body %}
    <h1>Rapport index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Date</th>
                <th>Description</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for rapport in rapports %}
            <tr>
                <td>{{ rapport.id }}</td>
                <td>{{ rapport.date ? rapport.date|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ rapport.description }}</td>
                <td>
                    <a href="{{ path('app_rapport_show', {'id': rapport.id}) }}">show</a>
                    <a href="{{ path('app_rapport_edit', {'id': rapport.id}) }}">edit</a>
                    <!-- Ajout du lien pour créer un rapport -->
                    <a href="{{ path('app_rapport_new', {'consultation_id': rapport.consultation.id}) }}">Create new</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
