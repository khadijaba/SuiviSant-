{% extends 'base.html.twig' %}

{% block title %}Rapports de la Consultation{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Rapports de la Consultation du {{ consultation.dateConsultation|date('d/m/Y') }}</h1>
        <a href="{{ path('app_rapport_new', {'consultation': consultation.id}) }}" class="btn btn-primary">Nouveau Rapport</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for rapport in rapports %}
                <tr>
                    <td>{{ rapport.date ? rapport.date|date('d/m/Y') : '' }}</td>
                    <td>{{ rapport.description }}</td>
                    <td>
                        <div class="btn-group">
                            <a href="{{ path('app_rapport_show', {'id': rapport.id}) }}" class="btn btn-sm btn-info">Voir</a>
                            <a href="{{ path('app_rapport_edit', {'id': rapport.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="text-center">Aucun rapport trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <a href="{{ path('app_consultation_show', {'id': consultation.id}) }}" class="btn btn-secondary">Retour à la consultation</a>
    </div>
{% endblock %} 