<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Rapport PDF</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        h1 { color: #333; }
        .container { border: 1px solid #ddd; padding: 15px; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Rapport N°{{ rapport.id }}</h1>
        <p><strong>Patient :</strong> {{ rapport.patient.nom }} {{ rapport.patient.prenom }}</p>
        <p><strong>Contenu :</strong> {{ rapport.contenu }}</p>
        <p><strong>Date :</strong> {{ rapport.date|date('d/m/Y') }}</p>
    </div>
</body>
</html>
