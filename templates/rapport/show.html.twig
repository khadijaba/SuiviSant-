{% extends 'base.html.twig' %}

{% block title %}Rapport{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h3 mb-0">Rapport du {{ rapport.date|date('d/m/Y') }}</h1>
                <div class="btn-group">
                    <a href="{{ path('app_rapport_edit', {'id': rapport.id}) }}" class="btn btn-warning">Modifier</a>
                    <form method="post" action="{{ path('app_rapport_delete', {'id': rapport.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce rapport ?');" style="display: inline-block;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rapport.id) }}">
                        <button class="btn btn-danger">Supprimer</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="card-body">
            <table class="table">
                <tbody>
                    <tr>
                        <th>Date</th>
                        <td>{{ rapport.date ? rapport.date|date('d/m/Y') : '' }}</td>
                    </tr>
                    <tr>
                        <th>Description</th>
                        <td>{{ rapport.description }}</td>
                    </tr>
                    <tr>
                        <th>Contenu</th>
                        <td style="white-space: pre-wrap;">{{ rapport.contenu }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="card-footer">
            <a href="{{ path('app_rapport_index', {'consultation': rapport.consultation.id}) }}" class="btn btn-secondary">Retour aux rapports</a>
        </div>
    </div>
{% endblock %} 