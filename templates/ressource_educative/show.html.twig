{% extends 'base.html.twig' %}
{% block title %}Ressource Éducative{% endblock %}

{% block body %}

<!DOCTYPE html> 
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <div class="sidebar bg-dark text-light p-3" style="width: 250px; min-height: 100vh;">
            <h3 class="text-center">Admin Dashboard</h3>
            <a href="#" class="d-block text-light py-2"><i class="fas fa-home me-2"></i> Dashboard</a>
            <a href="#" class="d-block text-light py-2"><i class="fas fa-users me-2"></i> Utilisateurs</a>
            <a href="#" class="d-block text-light py-2"><i class="fas fa-calendar-check me-2"></i> Rendez-vous</a>
            <a href="#" class="d-block text-light py-2 bg-primary text-white"><i class="fas fa-book me-2"></i> Ressources Éducatives</a>
            <a href="#" class="d-block text-light py-2"><i class="fas fa-stethoscope me-2"></i> Consultation</a>
            <a href="#" class="d-block text-light py-2"><i class="fas fa-comments me-2"></i> Forum</a>
            <a href="#" class="d-block text-light py-2"><i class="fas fa-chart-line me-2"></i> Analytics</a>
            <a href="#" class="d-block text-light py-2"><i class="fas fa-cog me-2"></i> Paramètres</a>
        </div>
        
        <!-- Main content -->
        <div class="container-fluid p-4" style="margin-left: 250px;">
            <h1 class="mb-4 text-primary">Détails de la Ressource Éducative</h1>

            <table class="table table-bordered bg-white shadow-sm rounded">
                <tbody>
                    <tr>
                        <th>ID</th>
                        <td>{{ ressource_educative.id }}</td>
                    </tr>
                    <tr>
                        <th>Titre</th>
                        <td>{{ ressource_educative.titre }}</td>
                    </tr>
                    <tr>
                        <th>Contenu</th>
                        <td>{{ ressource_educative.contenu }}</td>
                    </tr>
                    <tr>
                        <th>Auteur</th>
                        <td>{{ ressource_educative.auteur }}</td>
                    </tr>
                    <tr>
                        <th>Date de Publication</th>
                        <td>{{ ressource_educative.datePublication ? ressource_educative.datePublication|date('Y-m-d H:i:s') : 'Non spécifiée' }}</td>
                    </tr>
                    <tr>
                        <th>Image</th>
                        <td>
                            {% if ressource_educative.image %}
                                <img src="{{ asset('uploads/images/' ~ ressource_educative.image) }}" alt="Image" class="img-fluid" style="max-width: 200px;">
                            {% else %}
                                Aucune image disponible
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>Vidéo</th>
                        <td>
                            {% if ressource_educative.video %}
                                <video controls width="300">
                                    <source src="{{ asset('uploads/videos/' ~ ressource_educative.video) }}" type="video/mp4">
                                    Votre navigateur ne supporte pas la lecture de vidéos.
                                </video>
                            {% else %}
                                Aucune vidéo disponible
                            {% endif %}
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="d-flex gap-3">
                <a href="{{ path('app_ressource_educative_index') }}" class="btn btn-secondary">Retour à la liste</a>
                <a href="{{ path('app_ressource_educative_edit', {'id': ressource_educative.id}) }}" class="btn btn-primary">Modifier</a>
                {{ include('ressource_educative/_delete_form.html.twig', {'class': 'btn btn-danger'}) }}
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
{% endblock %}
