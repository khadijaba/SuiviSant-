                        <h5 class="mb-lg-4 mb-3">Our Clinic</h5>
                        <p><a href="mailto:hello@company.co">hello@company.co</a></p>
                        <p>123 Digital Art Street, San Diego, CA 92123</p>
                    </div>
                    <div class="col-lg-3 col-md-6 col-12 ms-auto">
                        <h5 class="mb-lg-4 mb-2">Socials</h5>
                        <ul class="social-icon">
                            <li><a href="#" class="social-icon-link bi-facebook"></a></li>
                            <li><a href="#" class="social-icon-link bi-twitter"></a></li>
                            <li><a href="#" class="social-icon-link bi-instagram"></a></li>
                            <li><a href="#" class="social-icon-link bi-youtube"></a></li>
                        </ul>
                        <div>
                            <p class="copyright-text">Copyright © Bien-Être+ 2021</p>
                            <p class="copyright-text">Design: <a href="https://templatemo.com" target="_parent">TemplateMo</a></p>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
{% endblock %}
        <!-- JavaScript Files -->
        {% block javascripts %}
            {{ encore_entry_script_tags('app')}}
            <script src="{{ asset('assets/js/jquery.min.js') }}"></script>
            <script src="{{ asset('assets/js/bootstrap.bundle.min.js') }}"></script>
            <script src="{{ asset('assets/js/owl.carousel.min.js') }}"></script>
            <script src="{{ asset('assets/js/scrollspy.min.js') }}"></script>
            <script src="{{ asset('assets/js/custom.js') }}"></script>

            <!-- FullCalendar JS -->
            <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.10.1/main.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.10.1/locales-all.min.js"></script>

            <!-- JavaScript to Control Carousel -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        var owl = $(".reviews-carousel");

        owl.owlCarousel({
            loop: true,
            margin: 20,
            nav: false, // Default nav disabled
            dots: false, // Hide default dots
            autoplay: true,
            autoplayTimeout: 3000,
            autoplayHoverPause: true,
            responsive: {
                0: { items: 1 },
                600: { items: 2 },
                1000: { items: 3 }
            }
        });

        // Custom Navigation Buttons
        $(".prev-btn").click(function() {
            owl.trigger('prev.owl.carousel');
        });

        $(".next-btn").click(function() {
            owl.trigger('next.owl.carousel');
        });
    });
</script>

<!-- Add CSS for star rating -->
<style>
    .rating-container {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
    }
    
    .stars {
        display: inline-flex;
        margin-right: 10px;
    }
    
    .star {
        color: #e0e0e0;
        cursor: pointer;
        padding: 0 2px;
        transition: color 0.2s;
    }
    
    .star.selected, 
    .star.hovered {
        color: #ffc107;
    }
</style>

<!-- Add JavaScript for star rating -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const ratingContainers = document.querySelectorAll('.rating-container');
        
        ratingContainers.forEach(container => {
            const stars = container.querySelectorAll('.star');
            const programmeName = container.dataset.programme;
            
            // Get stored rating from localStorage if available
            const storedRating = localStorage.getItem(`programme_rating_${programmeName}`);
            if (storedRating) {
                updateStarDisplay(stars, parseInt(storedRating));
            }
            
            stars.forEach(star => {
                // Hover effect
                star.addEventListener('mouseenter', () => {
                    const value = parseInt(star.dataset.value);
                    stars.forEach(s => {
                        if (parseInt(s.dataset.value) <= value) {
                            s.classList.add('hovered');
                        } else {
                            s.classList.remove('hovered');
                        }
                    });
                });
                
                // Remove hover effect
                container.addEventListener('mouseleave', () => {
                    stars.forEach(s => s.classList.remove('hovered'));
                });
                
                // Star click
                star.addEventListener('click', () => {
                    const value = parseInt(star.dataset.value);
                    
                    // Store the rating in localStorage
                    localStorage.setItem(`programme_rating_${programmeName}`, value);
                    
                    // Update display
                    updateStarDisplay(stars, value);
                    
                    // Update the vote count
                    const countElement = container.querySelector('.rating-count');
                    let count = parseInt(countElement.textContent.match(/\d+/)[0]) || 0;
                    if (!star.classList.contains('selected')) {
                        count++;
                    }
                    countElement.textContent = `(${count} votes)`;
                    
                    // In a real app, you'd send this to a server
                    console.log(`Programme ${programmeName} rated ${value}/5`);
                });
            });
        });
        
        function updateStarDisplay(stars, selectedValue) {
            stars.forEach(s => {
                if (parseInt(s.dataset.value) <= selectedValue) {
                    s.classList.add('selected');
                    s.classList.remove('bi-star');
                    s.classList.add('bi-star-fill');
                } else {
                    s.classList.remove('selected');
                    s.classList.remove('bi-star-fill');
                    s.classList.add('bi-star');
                }
            });
        }
    });
</script>
        {% endblock %}
    </body>
</html>