{% extends 'base.html.twig' %}

{% block title %}Utilisateur{% endblock %}

{% block body %}
    <!-- Navigation -->
    <ul class="nav">
        <li class="nav-item">
            <a class="nav-link" href="{{ path('app_ressource_educative_index') }}">Ressource</a>
        </li>
    </ul>
   
    <!-- Ressource Section -->
    <h2 id="Ressource">Liste des ressources éducatives</h2>
    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Titre</th>
                <th>Contenu</th>
                <th>Auteur</th>
                <th>DatePublication</th>
                <th>Image</th>
                <th>Video</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for ressource in ressources_educatives %}
                <tr>
                    <td>{{ ressource.id }}</td>
                    <td>{{ ressource.titre }}</td>
                    <td>{{ ressource.contenu }}</td>
                    <td>{{ ressource.auteur }}</td>
                    <td>{{ ressource.datePublication ? ressource.datePublication|date('Y-m-d') : '' }}</td>
                    <td><img src="{{ asset('images/' ~ ressource.image) }}" alt="Image" width="100"></td>
                    <td><video width="100" controls>
                            <source src="{{ asset('videos/' ~ ressource.video) }}" type="video/mp4">
                            Your browser does not support the video tag.
                        </video></td>
                    <td>
                        <a href="{{ path('app_ressource_educative_edit', {'id': ressource.id}) }}">Edit</a>
                        <a href="{{ path('app_ressource_educative_show', {'id': ressource.id}) }}">Show</a>

                        <!-- Formulaire de suppression -->
                        <form method="POST" action="{{ path('app_ressource_educative_delete', {'id': ressource.id}) }}" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this resource?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ ressource.id) }}">
                            <button class="btn btn-danger" type="submit">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_ressource_educative_index') }}">Retour à la liste</a>

    <h1>CategorieRessource index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Description</th>
                <th>Image</th>
                <th>Date Creation</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for categorie_ressource in categorie_ressources %}
            <tr>
                <td>{{ categorie_ressource.id }}</td>
                <td>{{ categorie_ressource.nom }}</td>
                <td>{{ categorie_ressource.description }}</td>
                <td>
                    {% if categorie_ressource.image %}
                        <img src="{{ categorie_ressource.image }}" alt="Image" style="max-width: 100px;">
                    {% else %}
                        <span>No Image</span>
                    {% endif %}
                </td>
                <td>{{ categorie_ressource.dateCreation ? categorie_ressource.dateCreation|date('Y-m-d H:i:s') : 'No Date' }}</td>
                <td>
                    <a href="{{ path('app_categorie_ressource_show', {'id': categorie_ressource.id}) }}">show</a>
                    <a href="{{ path('app_categorie_ressource_edit', {'id': categorie_ressource.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">No records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_categorie_ressource_new') }}">Créer une nouvelle catégorie</a>
{% endblock %}
