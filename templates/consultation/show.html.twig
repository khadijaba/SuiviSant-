{% extends 'base.html.twig' %}

{% block title %}Consultation{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h3 mb-0">Consultation</h1>
                <div class="btn-group">
                    <a href="{{ path('app_consultation_edit', {'id': consultation.id}) }}" class="btn btn-warning">Modifier</a>
                    <a href="{{ path('app_rapport_index', {'consultation': consultation.id}) }}" class="btn btn-success">Rapports</a>
                    <form method="post" action="{{ path('app_consultation_delete', {'id': consultation.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette consultation ?');" style="display: inline-block;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ consultation.id) }}">
                        <button class="btn btn-danger">Supprimer</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="card-body">
            <table class="table">
                <tbody>
                    <tr>
                        <th>Date de consultation</th>
                        <td>{{ consultation.dateConsultation ? consultation.dateConsultation|date('d/m/Y') : '' }}</td>
                    </tr>
                    <tr>
                        <th>Description</th>
                        <td>{{ consultation.description }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="card-footer">
            <a href="{{ path('app_consultation_index') }}" class="btn btn-secondary">Retour à la liste</a>
        </div>
    </div>
{% endblock %} 