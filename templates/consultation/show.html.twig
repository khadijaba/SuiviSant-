{% extends 'base.html.twig' %}

{% block title %}Consultation{% endblock %}

   {% block body %}

    <div class="container mt-4">
        <h1 class="mb-3">Détails de la Consultation</h1>

        <table class="table table-bordered">
            <tbody>
                <tr>
                    <th>ID</th>
                    <td>{{ consultation.id }}</td>
                </tr>
                <tr>
                    <th>Date</th>
                    <td>{{ consultation.date ? consultation.date|date('Y-m-d H:i:s') : 'Non spécifiée' }}</td>
                </tr>
                <tr>
                    <th>Description</th>
                    <td>{{ consultation.description }}</td>
                </tr>
            </tbody>
        </table>

        {# Vérification si un rapport est disponible #}
        {% if consultation.rapport is null %}
            <div class="alert alert-warning">
                <p>Le rapport n'est pas encore disponible.</p>
                <a href="{{ path('app_consultation_add_rapport', {'id': consultation.id}) }}" class="btn btn-primary">
                    Ajouter un rapport
                </a>
            </div>
        {% else %}
            <div class="card mt-4">
                <div class="card-header bg-success text-white">
                    Rapport de Consultation
                </div>
                <div class="card-body">
                    <p>{{ consultation.rapport.contenu }}</p>
                </div>
            </div>
        {% endif %}

        <div class="mt-4">
            <a href="{{ path('app_consultation_index') }}" class="btn btn-secondary">Retour à la liste</a>
            <a href="{{ path('app_consultation_edit', {'id': consultation.id}) }}" class="btn btn-warning">Modifier</a>
        </div>

        {# Formulaire de suppression avec confirmation #}
        <form action="{{ path('app_consultation_delete', {'id': consultation.id}) }}" method="post" class="mt-3" 
              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette consultation ? Cette action est irréversible.')">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ consultation.id) }}">
            <button type="submit" class="btn btn-danger">Supprimer</button>
        </form>
    </div>
{% endblock %}
