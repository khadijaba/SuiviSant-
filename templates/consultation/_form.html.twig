{% extends 'base.html.twig' %}

{% block title %}Ajouter/Modifier une consultation{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-3">Formulaire Consultation</h1>

        <div class="card">
            <div class="card-body">
                {# Affichage des erreurs globales #}
                {% for error in form.vars.errors %}
                    <div class="alert alert-danger">{{ error.message }}</div>
                {% endfor %}

                <form method="post">
                    {{ form_start(form,{'attr': {'novalidate': 'novalidate'}} ) }}

                    <div class="mb-3">
                        {{ form_label(form.date, 'Date de consultation', { 'label_attr': {'class': 'form-label'} }) }}
                        {{ form_widget(form.date, { 'attr': {'class': 'form-control'} }) }}
                        
                        {# Affichage des erreurs spécifiques pour 'date' #}
                        {% for error in form.date.vars.errors %}
                            <div class="text-danger mt-1">{{ error.message }}</div>
                        {% endfor %}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.description, 'Description', { 'label_attr': {'class': 'form-label'} }) }}
                        {{ form_widget(form.description, { 'attr': {'class': 'form-control'} }) }}

                        {# Affichage des erreurs spécifiques pour 'description' #}
                        {% for error in form.description.vars.errors %}
                            <div class="text-danger mt-1">{{ error.message }}</div>
                        {% endfor %}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.rapport, 'Rapport (optionnel)', { 'label_attr': {'class': 'form-label'} }) }}
                        {{ form_widget(form.rapport, { 'attr': {'class': 'form-control'} }) }}
                        
                        {# Affichage des erreurs spécifiques pour 'rapport' #}
                        {% for error in form.rapport.vars.errors %}
                            <div class="text-danger mt-1">{{ error.message }}</div>
                        {% endfor %}
                    </div>

                    <button class="btn btn-primary">Enregistrer</button>
                    {{ form_end(form) }}
                </form>

                <a href="{{ path('app_consultation_index') }}" class="btn btn-secondary mt-3">
                    Retour à la liste des consultations
                </a>
            </div>
        </div>
    </div>
{% endblock %}
