{% extends 'base.html.twig' %}

{% block title %}Liste des Consultations{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Mes Consultations</h1>
            <a href="{{ path('app_consultation_new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Nouvelle Consultation
            </a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">
                {{ message }}
            </div>
        {% endfor %}

        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for consultation in consultations %}
                    <tr>
                        <td>{{ consultation.dateConsultation ? consultation.dateConsultation|date('d/m/Y H:i') : '' }}</td>
                        <td>{{ consultation.description }}</td>
                        <td>
                            <div class="btn-group">
                                <a href="{{ path('app_consultation_show', {'id': consultation.id}) }}" class="btn btn-info btn-sm">
                                    <i class="fas fa-eye"></i> Voir
                                </a>
                                <a href="{{ path('app_consultation_edit', {'id': consultation.id}) }}" class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit"></i> Modifier
                                </a>
                                {% if consultation.rapport %}
                                    <a href="{{ path('app_rapport_show', {'id': consultation.rapport.id}) }}" class="btn btn-success btn-sm">
                                        <i class="fas fa-file-medical"></i> Voir rapport
                                    </a>
                                {% else %}
                                    <a href="{{ path('app_rapport_new', {'consultation': consultation.id}) }}" class="btn btn-success btn-sm">
                                        <i class="fas fa-file-medical"></i> Ajouter un rapport
                                    </a>
                                {% endif %}
                                <form action="{{ path('app_consultation_delete', {'id': consultation.id}) }}" method="post" style="display: inline-block;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette consultation ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ consultation.id) }}">
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash"></i> Supprimer
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-center">Aucune consultation trouvée</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
