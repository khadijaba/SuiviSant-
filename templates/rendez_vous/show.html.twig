{% extends 'base.html.twig' %}

{% block title %}RendezVous Details{% endblock %}

{% block body %}
    <style>
        .sidebar {
            background-color: #2c3e50;
            color: #ecf0f1;
            position: fixed;
            top: 0;
            left: 0;
            width: 240px;
            height: 100vh;
            padding: 1rem;
            overflow-y: auto;
        }

        .sidebar a {
            color: #ecf0f1;
            text-decoration: none;
            font-size: 1rem;
            padding: 0.8rem;
            display: block;
            margin-bottom: 10px;
            border-radius: 5px;
        }

        .sidebar a:hover {
            background-color: #34495e;
        }

        .sidebar .sidebar-header {
            font-size: 1.5rem;
            font-weight: bold;
            margin-bottom: 2rem;
            text-align: center;
        }

        .main-content {
            margin-left: 240px;
            padding: 20px;
            width: calc(100% - 240px);
        }

        .navbar {
            margin-left: 240px;
            width: calc(100% - 240px);
        }
    </style>

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">Admin Dashboard</div>
        <a href="{{ path('dashboard') }}"><i class="fas fa-home"></i> Dashboard</a>
        <a href="{{ path('app_dispo_expert_index') }}"><i class="fas fa-users"></i> Disponibilité Expert</a>
        <a href="{{ path('app_rendez_vous_index') }}"><i class="fas fa-calendar"></i> Rendez-vous</a>
        <a href="#"><i class="fas fa-book"></i> Ressources Éducatives</a>
        <a href="#"><i class="fas fa-comments"></i> Consultation</a>
        <a href="#"><i class="fas fa-comments"></i> Forum</a>
        <a href="#"><i class="fas fa-chart-line"></i> Analytics</a>
        <a href="#"><i class="fas fa-cog"></i> Settings</a>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Navigation Bar -->
        <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
            <div class="container-fluid">
                <form class="d-flex">
                    <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search">
                    <button class="btn btn-outline-success" type="submit"><i class="fas fa-search"></i></button>
                </form>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="fas fa-envelope"></i></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="fas fa-bell"></i></a>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Rendez-vous Details -->
        <div class="container mt-4">
            <h1 class="mb-4">Rendez-vous Details</h1>

            <table class="table table-bordered">
                <tr>
                    <th>ID</th>
                    <td>{{ rendez_vous.id }}</td>
                </tr>
                <tr>
                    <th>Phone Number</th>
                    <td>{{ rendez_vous.phoneNumber }}</td>
                </tr>
                <tr>
                    <th>Email</th>
                    <td>{{ rendez_vous.Email }}</td>
                </tr>
                <tr>
                    <th>Message</th>
                    <td>{{ rendez_vous.Message }}</td>
                </tr>
                <tr>
                    <th>Dispo Expert</th>
                    <td>
                        {% if rendez_vous.dispoExpert %}
                            {{ rendez_vous.dispoExpert.id }} - 
                            {% if rendez_vous.dispoExpert.status %}
                                <span class="text-success">Available</span>
                            {% else %}
                                <span class="text-danger">Unavailable</span>
                            {% endif %}
                        {% else %}
                            <span class="text-muted">Not assigned</span>
                        {% endif %}
                    </td>
                </tr>
            </table>

            <a href="{{ path('app_rendez_vous_index') }}" class="btn btn-secondary">Back to list</a>
            <a href="{{ path('app_rendez_vous_edit', {'id': rendez_vous.id}) }}" class="btn btn-primary">Edit</a>
            {{ include('rendez_vous/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
