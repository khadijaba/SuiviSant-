{% extends 'base.html.twig' %}

{% block title %}Rendez-vous List{% endblock %}

{% block body %}

<div class="d-flex">
  
    <!-- Main Content -->
    <div class="main-content flex-grow-1">
        <!-- Navbar -->
        <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
    <div class="container-fluid">
        <form class="d-flex search-form">
            <div class="input-group">
                <input id="search-expert" class="form-control" type="search" placeholder="Search by Expert Name..." aria-label="Search">
                <button class="btn btn-success search-btn" type="button">
                    <i class="fas fa-search"></i> Search
                </button>
            </div>
        </form>
        <ul class="navbar-nav ms-auto">
            <li class="nav-item">
                <a class="nav-link" href="#"><i class="fas fa-envelope"></i></a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#"><i class="fas fa-bell"></i></a>
            </li>
        </ul>
    </div>
</nav>


        <!-- Content -->
        <div class="container mt-4">
            <h1 class="mb-4">Rendez-vous List</h1>

            <table class="table table-striped table-bordered" id="appointments-table">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Phone Number</th>
                        <th>Email</th>
                        <th>Message</th>
                        <th>Expert Name</th>
                        <th>Dispo Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for rendez_vou in rendez_vouses %}
                        <tr class="appointment-row">
                            <td>{{ rendez_vou.id }}</td>
                            <td>{{ rendez_vou.phoneNumber }}</td>
                            <td>{{ rendez_vou.email }}</td>
                            <td>{{ rendez_vou.message }}</td>
                            <td class="expert-name">
                                {{ rendez_vou.dispoExpert and rendez_vou.dispoExpert.expert ? rendez_vou.dispoExpert.expert.name : 'No Expert Assigned' }}
                            </td>
                            <td>
                                {{ rendez_vou.dispoExpert ? rendez_vou.dispoExpert.date|date('Y-m-d H:i') : 'N/A' }}
                            </td>
                            <td>
                                <a href="{{ path('app_rendez_vous_show', {'id': rendez_vou.id}) }}" class="btn btn-info btn-sm">
                                    <i class="fas fa-eye"></i> View
                                </a>
                                <form action="{{ path('app_rendez_vous_delete', {'id': rendez_vou.id}) }}" method="post" style="display:inline;" 
                                      onsubmit="return confirm('Are you sure you want to delete this entry?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rendez_vou.id) }}">
                                    <button class="btn btn-danger btn-sm" type="submit">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center">No rendez-vous found.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    body {
        font-family: 'Roboto', sans-serif;
        background-color: #f4f6f9;
    }
    .sidebar {
        background-color: #2c3e50;
        min-height: 100vh;
        color: #ecf0f1;
        padding: 1rem;
        position: fixed;
        width: 240px;
    }
    .sidebar a {
        color: #ecf0f1;
        text-decoration: none;
        font-size: 1rem;
        padding: 0.8rem;
        display: block;
        margin-bottom: 10px;
        border-radius: 5px;
    }
    .sidebar a:hover {
        background-color: #34495e;
    }
    .sidebar .sidebar-header {
        font-size: 1.5rem;
        font-weight: bold;
        margin-bottom: 2rem;
    }
    body, html {
        margin: 0;
        padding: 0;
        overflow-x: hidden;
    }
    .main-content {
        margin-left: 260px;
        padding: 1rem;
        padding-top: 0;
    }
    .table {
        background-color: #fff;
        border-radius: 5px;
        border: 1px solid #ddd;
        margin-top: 20px;
    }
    .table th, .table td {
        padding: 10px;
        text-align: center;
    }
    .table th {
        background-color: #2c3e50;
        color: #ecf0f1;
    }
    .table tr:nth-child(even) {
        background-color: #f4f6f9;
    }
    .actions {
        display: flex;
        justify-content: space-around;
    }
    .actions a {
        color: #3498db;
        text-decoration: none;
        font-size: 1.25rem;
    }
    .actions a:hover {
        color: #2980b9;
    }
    .btn-create {
        background-color: #3498db;
        color: #fff;
        padding: 10px 15px;
        border-radius: 5px;
        text-decoration: none;
    }
    .btn-create:hover {
        background-color: #2980b9;
    }
    .search-form {
    width: 100%;
    max-width: 400px;
}

.search-btn {
    background-color: #28a745; /* Green */
    color: white;
    border: none;
    padding: 8px 15px;
    font-weight: bold;
    border-radius: 5px;
    transition: 0.3s ease-in-out;
}

.search-btn:hover {
    background-color: #218838; /* Darker Green */
    transform: scale(1.05);
}

</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("search-expert");
        const rows = document.querySelectorAll(".appointment-row");

        searchInput.addEventListener("keyup", function () {
            const searchValue = searchInput.value.toLowerCase();

            rows.forEach(row => {
                const expertName = row.querySelector(".expert-name").textContent.toLowerCase();
                if (expertName.includes(searchValue)) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        });
    });
</script>

{% endblock %}
