{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

    <div class="mb-4">
        {{ form_label(form.body, 'Votre réponse', {'label_attr': {'class': 'form-label fw-bold'}}) }}
        
        {{ form_widget(form.body, {
            'attr': {
                'class': 'form-control',
                'rows': 5,
                'placeholder': 'Tapez votre réponse ici...',
                'required': 'required'
            }
        }) }}
        
        {# Display validation error messages in red #}
        <div class="invalid-feedback">
            {{ form_errors(form.body) }}
        </div>

        <small class="form-text text-muted">
            Soyez aussi précis que possible dans votre réponse.
        </small>
    </div>

    <div class="d-flex justify-content-end">
        <button type="submit" class="btn btn-primary btn-sm">
            <i class="fas fa-save me-2"></i> {{ button_label|default('Enregistrer') }}
        </button>
    </div>

{{ form_end(form) }}
