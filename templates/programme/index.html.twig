{% extends 'base.html.twig' %}

{% block title %}Liste des programmes{% endblock %}

{% block body %}
    <div class="container mt-5 pt-5">
        <h1>Liste des programmes</h1>

        <div class="d-flex justify-content-between mb-3">
            <a href="{{ path('app_programme_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Créer un nouveau programme
            </a>
            <a href="{{ path('dashboard') }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Retour au tableau de bord
            </a>
        </div>

        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nom</th>
                    <th>Date</th>
                    <th>Progression</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for programme in programmes %}
                <tr>
                    <td>{{ programme.id }}</td>
                    <td>{{ programme.nom }}</td>
                    <td>{{ programme.date ? programme.date|date('Y-m-d H:i:s') : '' }}</td>
                    <td>{{ programme.progression }}</td>
                    <td>
                        <div class="btn-group">
                            <a href="{{ path('app_programme_show', {'id': programme.id}) }}" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a href="{{ path('app_programme_edit', {'id': programme.id}) }}" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center">Aucun programme trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %} 