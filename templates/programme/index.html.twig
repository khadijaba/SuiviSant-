{% extends 'base.html.twig' %}

{% block title %}Gestion des Programmes{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .programme-card {
            transition: transform 0.3s ease-in-out;
            border: none;
            border-radius: 15px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        .programme-card:hover {
            transform: translateY(-5px);
        }
        .progress {
            height: 8px;
            border-radius: 4px;
        }
        .rating-stars {
            color: #ffc107;
        }
        .like-buttons button {
            transition: all 0.3s ease;
        }
        .like-buttons button:hover {
            transform: scale(1.1);
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 mb-0">Gestion des Programmes</h1>
        <a href="{{ path('app_programme_new') }}" class="btn btn-primary">
            <i class="fas fa-plus-circle me-2"></i>Nouveau Programme
        </a>
    </div>

    <div class="row">
        {% for programme in programmes %}
            <div class="col-12 col-md-6 col-lg-4 mb-4">
                <div class="card programme-card">
                    <div class="card-body">
                        <h5 class="card-title">{{ programme.nom }}</h5>
                        <p class="text-muted mb-2">
                            <i class="fas fa-calendar-alt me-2"></i>
                            {{ programme.date|date('d/m/Y') }}
                        </p>
                        
                        <div class="mb-3">
                            <label class="form-label small text-muted">Progression</label>
                            <div class="progress">
                                <div class="progress-bar bg-success" 
                                     role="progressbar" 
                                     style="width: {{ programme.progression }}%"
                                     aria-valuenow="{{ programme.progression }}" 
                                     aria-valuemin="0" 
                                     aria-valuemax="100">
                                    {{ programme.progression }}%
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small text-muted">Évaluation</label>
                            <div class="rating-stars">
                                {% for i in 1..5 %}
                                    <i class="fas fa-star{% if i > programme.evaluation %}-o{% endif %}"></i>
                                {% endfor %}
                            </div>
                        </div>

                        <div class="like-buttons d-flex gap-2 mb-3">
                            <button class="btn btn-outline-success btn-sm flex-grow-1" 
                                    onclick="likeProgramme('{{ programme.nom }}')"
                                    data-bs-toggle="tooltip" 
                                    title="J'aime">
                                <i class="fas fa-thumbs-up me-1"></i>
                                <span class="likes-count">{{ programme.likes }}</span>
                            </button>
                            <button class="btn btn-outline-danger btn-sm flex-grow-1"
                                    onclick="dislikeProgramme('{{ programme.nom }}')"
                                    data-bs-toggle="tooltip" 
                                    title="Je n'aime pas">
                                <i class="fas fa-thumbs-down me-1"></i>
                                <span class="dislikes-count">{{ programme.dislikes }}</span>
                            </button>
                        </div>

                        <div class="d-flex gap-2">
                            <a href="{{ path('app_programme_show', {'nom': programme.nom}) }}" 
                               class="btn btn-info btn-sm flex-grow-1">
                                <i class="fas fa-eye me-1"></i>Voir
                            </a>
                            <a href="{{ path('app_programme_edit', {'nom': programme.nom}) }}" 
                               class="btn btn-warning btn-sm flex-grow-1">
                                <i class="fas fa-edit me-1"></i>Modifier
                            </a>
                            <form method="post" action="{{ path('app_programme_delete', {'nom': programme.nom}) }}" 
                                  class="flex-grow-1 m-0"
                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce programme ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ programme.nom) }}">
                                <button class="btn btn-danger btn-sm w-100">
                                    <i class="fas fa-trash-alt me-1"></i>Supprimer
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>Aucun programme trouvé.
                    <a href="{{ path('app_programme_new') }}" class="alert-link">Créer votre premier programme</a>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    function likeProgramme(nom) {
        fetch(`/programme/${nom}/like`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            }
        })
        .then(response => response.json())
        .then(data => {
            const card = document.querySelector(`[data-programme="${nom}"]`);
            card.querySelector('.likes-count').textContent = data.likes;
        });
    }

    function dislikeProgramme(nom) {
        fetch(`/programme/${nom}/dislike`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            }
        })
        .then(response => response.json())
        .then(data => {
            const card = document.querySelector(`[data-programme="${nom}"]`);
            card.querySelector('.dislikes-count').textContent = data.dislikes;
        });
    }

    // Initialize tooltips
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl)
    });
</script>
{% endblock %} 