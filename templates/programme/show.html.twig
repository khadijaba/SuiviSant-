{% extends 'base.html.twig' %}

{% block title %}Programme détail{% endblock %}

{% block body %}
    <div class="container mt-5 pt-5">
        <h1>Détails du programme</h1>

        <div class="card mb-4">
            <div class="card-body">
                <table class="table">
                    <tbody>
                        <tr>
                            <th>ID</th>
                            <td>{{ programme.id }}</td>
                        </tr>
                        <tr>
                            <th>Nom</th>
                            <td>{{ programme.nom }}</td>
                        </tr>
                        <tr>
                            <th>Date</th>
                            <td>{{ programme.date ? programme.date|date('Y-m-d H:i:s') : '' }}</td>
                        </tr>
                        <tr>
                            <th>Progression</th>
                            <td>{{ programme.progression }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex">
            <a href="{{ path('app_programme_index') }}" class="btn btn-secondary me-2">
                <i class="bi bi-arrow-left"></i> Retour à la liste
            </a>
            <a href="{{ path('app_programme_edit', {'id': programme.id}) }}" class="btn btn-warning me-2">
                <i class="bi bi-pencil"></i> Modifier
            </a>
            {{ include('programme/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %} 