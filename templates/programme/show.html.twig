{% extends 'base.html.twig' %}

{% block title %}Détails du Programme{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h1 class="h3 mb-0">{{ programme.nom }}</h1>
                    </div>
                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <h5 class="card-subtitle mb-3">Informations</h5>
                                <p><strong>Date:</strong> {{ programme.date|date('d/m/Y') }}</p>
                                <p><strong>Progression:</strong> {{ programme.progression }}</p>
                                <p><strong>Évaluation:</strong> {{ programme.evaluation }}/5</p>
                            </div>
                            <div class="col-md-6">
                                <h5 class="card-subtitle mb-3">Statistiques</h5>
                                <div class="d-flex align-items-center mb-2">
                                    <button class="btn btn-sm btn-success me-2 like-btn" data-programme="{{ programme.nom }}">
                                        <i class="fas fa-thumbs-up"></i> <span>{{ programme.likes }}</span>
                                    </button>
                                    <button class="btn btn-sm btn-danger dislike-btn" data-programme="{{ programme.nom }}">
                                        <i class="fas fa-thumbs-down"></i> <span>{{ programme.dislikes }}</span>
                                    </button>
                                </div>
                                <p><strong>Note moyenne:</strong> {{ programme.rating|number_format(1) }}/5</p>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="{{ path('app_programme_index') }}" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Retour
                            </a>
                            <div>
                                <a href="{{ path('app_programme_edit', {'nom': programme.nom}) }}" class="btn btn-warning">
                                    <i class="fas fa-edit"></i> Modifier
                                </a>
                                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                    <i class="fas fa-trash"></i> Supprimer
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de confirmation de suppression -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Confirmer la suppression</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Êtes-vous sûr de vouloir supprimer ce programme ?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <form method="post" action="{{ path('app_programme_delete', {'nom': programme.nom}) }}" style="display: inline-block">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ programme.nom) }}">
                        <button type="submit" class="btn btn-danger">Confirmer la suppression</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    {% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const likeBtn = document.querySelector('.like-btn');
            const dislikeBtn = document.querySelector('.dislike-btn');

            likeBtn.addEventListener('click', function() {
                const nom = this.dataset.programme;
                fetch(`/programme/${nom}/like`, {method: 'POST'})
                    .then(response => response.json())
                    .then(data => {
                        this.querySelector('span').textContent = data.likes;
                        updateRating(data.rating);
                    });
            });

            dislikeBtn.addEventListener('click', function() {
                const nom = this.dataset.programme;
                fetch(`/programme/${nom}/dislike`, {method: 'POST'})
                    .then(response => response.json())
                    .then(data => {
                        this.querySelector('span').textContent = data.dislikes;
                        updateRating(data.rating);
                    });
            });

            function updateRating(rating) {
                document.querySelector('p strong:last-child').textContent = 
                    `${rating.toFixed(1)}/5`;
            }
        });
    </script>
    {% endblock %}
{% endblock %} 