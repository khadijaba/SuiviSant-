{% extends 'base.html.twig' %}

{% block title %}Modifier Programme{% endblock %}

{% block body %}
    <div class="container mt-5 pt-5">
        <h1>Modifier le programme</h1>

        {{ include('programme/_form.html.twig', {'button_label': 'Mettre à jour'}) }}

        <div class="d-flex mt-3">
            <a href="{{ path('app_programme_index') }}" class="btn btn-secondary me-2">
                <i class="bi bi-arrow-left"></i> Retour à la liste
            </a>

            {{ include('programme/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %} 