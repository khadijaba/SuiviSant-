{% extends 'base.html.twig' %}

{% block title %}Nouveau Programme{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h1 class="h3 mb-0">Créer un nouveau programme</h1>
                    </div>
                    <div class="card-body">
                        {% if errors is defined %}
                            <div class="alert alert-danger">
                                <ul class="mb-0">
                                    {% for error in errors %}
                                        <li>{{ error.message }}</li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}

                        <form method="post">
                            <div class="mb-3">
                                <label for="nom" class="form-label">Nom</label>
                                <input type="text" id="nom" name="nom" class="form-control" required 
                                       value="{{ programme is defined ? programme.nom : '' }}">
                            </div>

                            <div class="mb-3">
                                <label for="date" class="form-label">Date</label>
                                <input type="date" id="date" name="date" class="form-control" required
                                       value="{{ programme is defined ? programme.date|date('Y-m-d') : '' }}">
                            </div>

                            <div class="mb-3">
                                <label for="progression" class="form-label">Progression</label>
                                <input type="text" id="progression" name="progression" class="form-control" required
                                       value="{{ programme is defined ? programme.progression : '' }}">
                            </div>

                            <div class="mb-3">
                                <label for="evaluation" class="form-label">Évaluation (0-5)</label>
                                <input type="number" id="evaluation" name="evaluation" class="form-control" 
                                       min="0" max="5" step="1"
                                       value="{{ programme is defined ? programme.evaluation : '0' }}">
                            </div>

                            <div class="d-flex justify-content-between">
                                <a href="{{ path('app_programme_index') }}" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left"></i> Retour
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Enregistrer
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %} 