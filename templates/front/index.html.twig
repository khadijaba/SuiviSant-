<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description" content="">
        <meta name="author" content="">
        <title>{% block title %} Bien-Être+ {% endblock %}</title>

        <link rel="icon" href="{{ asset('assets/favicon.ico') }}">

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">

        <!-- CSS Files -->
        {{ encore_entry_link_tags('app') }} <!-- Webpack Encore -->
        <link rel="stylesheet" href="{{ asset('assets/css/bootstrap.min.css') }}">
        <link rel="stylesheet" href="{{ asset('assets/css/bootstrap-icons.css') }}">
        <link rel="stylesheet" href="{{ asset('assets/css/owl.carousel.min.css') }}">
        <link rel="stylesheet" href="{{ asset('assets/css/owl.theme.default.min.css') }}">
        <link rel="stylesheet" href="{{ asset('assets/css/templatemo-medic-care.css') }}">

        {% block stylesheets %}
        {% endblock %}
    </head>
   
    {% block body %}       
    <body>

        <!-- Navigation Bar -->
        <nav class="navbar navbar-expand-lg bg-light fixed-top shadow-lg">
            <div class="container">
                <a class="navbar-brand mx-auto d-lg-none" href="{{ path('app_home') }}">
                    Bien-Être+
                    <strong class="d-block">Health and Well-being</strong>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item active"></li>
                        <li class="nav-item"><a class="nav-link" href="#about">About</a></li>
                        <li class="nav-item"><a class="nav-link" href="#timeline">Timeline</a></li>
                        <a class="navbar-brand d-none d-lg-block" href="{{ path('app_home') }}">
                            Bien-Être+
                            <strong class="d-block">Health and Well-being</strong>
                        </a>
                        <li class="nav-item"><a class="nav-link" href="#reviews">Testimonials</a></li>
                        <li class="nav-item"><a class="nav-link" href="#booking">Booking</a></li>
                        <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_consultation_index') }}">Consultations</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Consultations Section -->
        <div class="main-content container-fluid">
            <h1 class="my-4">Consultations</h1>

            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for consultation in consultations %}
                        <tr>
                            <td>{{ consultation.id }}</td>
                            <td>{{ consultation.date ? consultation.date|date('Y-m-d H:i:s') : '' }}</td>
                            <td>{{ consultation.description }}</td>
                            <td>
                                <a class="btn btn-primary btn-sm" href="{{ path('app_consultation_show', {'id': consultation.id}) }}">Voir</a>
                                <a class="btn btn-warning btn-sm" href="{{ path('app_consultation_edit', {'id': consultation.id}) }}">Modifier</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4">Aucune consultation trouvée</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            <a class="btn btn-success" href="{{ path('app_consultation_new') }}">Créer une nouvelle consultation</a>
        </div>

        <!-- Footer -->
        {% block footer %}
        <footer class="site-footer section-padding" id="contact">
            <div class="container">
                <div class="row">
                    <div class="col-lg-5 me-auto col-12">
                        <h5 class="mb-lg-4 mb-3">Opening Hours</h5>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex">Sunday : Closed</li>
                            <li class="list-group-item d-flex">Monday - Friday <span>8:00 AM - 3:30 PM</span></li>
                            <li class="list-group-item d-flex">Saturday <span>10:30 AM - 5:30 PM</span></li>
                        </ul>
                    </div>
                    <div class="col-lg-2 col-md-6 col-12 my-4 my-lg-0">
                        <h5 class="mb-lg-4 mb-3">Our Clinic</h5>
                        <p><a href="mailto:hello@company.co">hello@company.co</a></p>
                        <p>123 Digital Art Street, San Diego, CA 92123</p>
                    </div>
                    <div class="col-lg-3 col-md-6 col-12 ms-auto">
                        <h5 class="mb-lg-4 mb-2">Socials</h5>
                        <ul class="social-icon">
                            <li><a href="#" class="social-icon-link bi-facebook"></a></li>
                            <li><a href="#" class="social-icon-link bi-twitter"></a></li>
                            <li><a href="#" class="social-icon-link bi-instagram"></a></li>
                            <li><a href="#" class="social-icon-link bi-youtube"></a></li>
                        </ul>
                        <div>
                            <p class="copyright-text">Copyright © Bien-Être+ 2021</p>
                            <p class="copyright-text">Design: <a href="https://templatemo.com" target="_parent">TemplateMo</a></p>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
        {% endblock %}

        <!-- JavaScript Files -->
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
            <script src="{{ asset('assets/js/jquery.min.js') }}"></script>
            <script src="{{ asset('assets/js/bootstrap.bundle.min.js') }}"></script>
            <script src="{{ asset('assets/js/owl.carousel.min.js') }}"></script>
            <script src="{{ asset('assets/js/scrollspy.min.js') }}"></script>
            <script src="{{ asset('assets/js/custom.js') }}"></script>
        {% endblock %}
        
    </body>
    {% endblock %}
</html>
