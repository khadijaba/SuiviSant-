{% extends 'base.html.twig' %}

{% block title %}Modifier la Réponse - Bien-Être+ {% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .answer-form-container {
        padding-top: 100px;
        min-height: 100vh;
        background-color: #f8f9fa;
    }
    .card-form {
        border: none;
        border-radius: 10px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
    .form-card-header {
        background-color: #6c757d;
        color: white;
        font-weight: 600;
        border-radius: 10px 10px 0 0;
    }
    .form-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 20px;
        border-top: 1px solid #eee;
    }
    .question-preview {
        background-color: #f7f7f7;
        padding: 15px;
        border-radius: 5px;
        margin-bottom: 20px;
    }
</style>
{% endblock %}

{% block body %}
<div class="answer-form-container">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <!-- Flash messages -->
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }} alert-dismissible fade show mb-4" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="{{ path('app_forum_index') }}">Forum</a></li>
                        <li class="breadcrumb-item"><a href="{{ path('app_question_show', {'id': answer.question.id}) }}">{{ answer.question.title|length > 30 ? answer.question.title|slice(0, 30) ~ '...' : answer.question.title }}</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Modifier la réponse</li>
                    </ol>
                </nav>

                <!-- Answer Edit Form -->
                <div class="card card-form mb-4">
                    <div class="card-header form-card-header">
                        <h3 class="mb-0">
                            <i class="bi bi-pencil-square me-2"></i>
                            Modifier votre réponse
                        </h3>
                    </div>
                    <div class="card-body p-4">
                        <!-- Question Preview -->
                        <div class="question-preview">
                            <h5>En réponse à:</h5>
                            <h6>{{ answer.question.title }}</h6>
                            <p class="text-muted mb-0">
                                {{ answer.question.content|striptags|length > 200 ? answer.question.content|striptags|slice(0, 200) ~ '...' : answer.question.content|striptags }}
                            </p>
                        </div>

                        {{ form_start(form) }}
                            <div class="row">
                                <div class="col-12">
                                    {{ form_row(form.content) }}
                                </div>
                                <div class="col-md-6">
                                    {{ form_row(form.authorName) }}
                                </div>
                                <div class="col-md-6">
                                    {{ form_row(form.authorEmail) }}
                                </div>
                            </div>

                            <div class="form-footer">
                                <a href="{{ path('app_question_show', {'id': answer.question.id}) }}" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left me-2"></i>
                                    Annuler
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-circle me-2"></i>
                                    Enregistrer les modifications
                                </button>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>

                <!-- Delete Section -->
                <div class="card border border-danger">
                    <div class="card-header bg-danger text-white">
                        <h4 class="mb-0">Zone de danger</h4>
                    </div>
                    <div class="card-body">
                        <h5>Supprimer cette réponse</h5>
                        <p class="text-muted">
                            Cette action est irréversible et supprimera définitivement votre réponse.
                        </p>
                        <form method="post" action="{{ path('app_answer_delete', {'id': answer.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette réponse?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ answer.id) }}">
                            <button class="btn btn-outline-danger">
                                <i class="bi bi-trash me-2"></i>
                                Supprimer définitivement
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 