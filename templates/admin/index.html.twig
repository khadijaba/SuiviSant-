<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>

    <!-- FontAwesome & Bootstrap -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            font-family: 'Roboto', sans-serif;
            background-color: #f4f6f9;
        }
        .sidebar {
            background-color: #2c3e50;
            min-height: 100vh;
            color: #ecf0f1;
            padding: 1rem;
            position: fixed;
            width: 240px;
        }
        .sidebar a {
            color: #ecf0f1;
            text-decoration: none;
            font-size: 1rem;
            padding: 0.8rem;
            display: block;
            margin-bottom: 10px;
            border-radius: 5px;
            cursor: pointer;
        }
        .sidebar a:hover {
            background-color: #34495e;
        }
        .main-content {
            margin-left: 260px;
            padding: 2rem;
        }
        .chart-container {
            background-color: #fff;
            border-radius: 15px;
            padding: 1rem;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        /* Cacher la liste des utilisateurs par défaut */
        #userListContainer {
            display: none;
        }
    </style>
</head>
<body>

<!-- Sidebar -->
<div class="sidebar">
    <div class="sidebar-header">Admin Dashboard</div>
    <a href="#"><i class="fas fa-home"></i> Dashboard</a>
    <a id="showUserList"><i class="fas fa-users"></i> Utilisateurs</a>
    <a href="#"><i class="fas fa-calendar"></i> Rendez-vous</a>
    <a href="#"><i class="fas fa-book"></i> Ressources Éducatives</a>
    <a href="#"><i class="fas fa-stethoscope"></i> Consultation</a>
    <a href="#"><i class="fas fa-comments"></i> Forum</a>
    <a href="#"><i class="fas fa-chart-line"></i> Analytics</a>
    <a href="#"><i class="fas fa-cog"></i> Settings</a>
</div>

<!-- Main Content -->
<div class="main-content">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="#">Admin Dashboard</a>

            <!-- Mobile Toggle Button -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navbar Items -->
            <div class="collapse navbar-collapse" id="navbarNav">
                <form class="d-flex ms-3">
                    <input class="form-control me-2" type="search" placeholder="Search..." aria-label="Search">
                    <button class="btn btn-outline-primary" type="submit"><i class="fa fa-search"></i></button>
                </form>

                <!-- Right-aligned Icons -->
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="fa fa-envelope"></i></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="fa fa-bell"></i></a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Liste des utilisateurs (Masquée par défaut) -->
    <div id="userListContainer" class="row mt-4">
        <div class="col-md-12">
            <div class="chart-container">
                <h1 class="text-center mb-4">Liste des Utilisateurs</h1>

                <div class="d-flex justify-content-end mb-3">
                    <input type="text" id="nom" class="form-control" placeholder="Rechercher par nom" />
                    <a href="{{ path('app_utilisateurr_new') }}" class="btn btn-primary">
                        <i class="fas fa-user-plus"></i> Ajouter un utilisateur
                    </a>
                </div>
        
                <table class="table table-striped table-hover shadow-sm">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Prénom</th>
                            <th>Email</th>
                            <th>Date de Naissance</th>
                            <th>Sexe</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for utilisateurr in utilisateurrs %}
                            <tr>
                                <td>{{ utilisateurr.id }}</td>
                                <td>{{ utilisateurr.nom }}</td>
                                <td>{{ utilisateurr.prenom }}</td>
                                <td>{{ utilisateurr.email }}</td>
                                <td>{{ utilisateurr.dateNaissance ? utilisateurr.dateNaissance|date('Y-m-d') : 'N/A' }}</td>
                                <td>{{ utilisateurr.sexe }}</td>
                                <td class="text-center">
                                    <a href="{{ path('app_utilisateurr_show', {'id': utilisateurr.id}) }}" class="btn btn-info btn-sm">
                                        <i class="fas fa-eye"></i> Voir
                                    </a>
                                    <a href="{{ path('app_utilisateurr_edit', {'id': utilisateurr.id}) }}" class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit"></i> Modifier
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center text-muted">Aucun utilisateur trouvé.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- JavaScript pour afficher/masquer la liste -->
<script>
    document.getElementById("showUserList").addEventListener("click", function () {
        let userList = document.getElementById("userListContainer");
        if (userList.style.display === "none") {
            userList.style.display = "block";  // Affiche la liste
        } else {
            userList.style.display = "none";   // Masque la liste
        }
    });
</script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
    $(document).ready(function() {
        $('#nom').on('input', function() {
            var nom = $(this).val();
            var showUrl = '{{ path('app_utilisateurr_show', {'id': '_id_'}) }}';
            var editUrl = '{{ path('app_utilisateurr_edit', {'id': '_id_'}) }}';

            $.ajax({
                url: '{{ path('app_utilisateur_rechercher') }}', // Ensure this matches the correct route
                method: 'POST',
                data: { nom: nom },
                success: function(response) {
                    var utilisateurs = response.utilisateurs;
                    var tbody = $('.table tbody');
                    tbody.empty();
                    utilisateurs.forEach(function(utilisateurr) {
                        console.log("ID de l'utilisateur : " + utilisateurr.id);
                        var tr = $('<tr>');
                        tr.append('<td>' + utilisateurr.id + '</td>');
                        tr.append('<td>' + utilisateurr.nom + '</td>');
                        tr.append('<td>' + utilisateurr.prenom + '</td>');
                        tr.append('<td>' + utilisateurr.email + '</td>');
                        tr.append('<td>' + (utilisateurr.dateNaissance ? new Date(utilisateurr.dateNaissance).toLocaleDateString('fr-FR') : 'N/A') + '</td>');
                        tr.append('<td>' + utilisateurr.sexe + '</td>');
                        var tdActions = $('<td>');
                        tdActions.append('<a href="' + showUrl.replace('_id_', utilisateurr.id) + '" class="btn btn-info btn-sm"><i class="fas fa-eye"></i> Voir</a>');
                        tdActions.append('<a href="' + editUrl.replace('_id_', utilisateurr.id) + '" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i> Modifier</a>');
                        tr.append(tdActions);
                        tbody.append(tr);
                    });
                },
                error: function(response) {
                    console.log(response); 
                }
            });
        });
    });
</script>
<!-- Bootstrap Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
