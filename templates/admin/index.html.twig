<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Roboto', sans-serif;
            background-color: #f4f6f9;
        }
        .sidebar {
            background-color: #2c3e50;
            min-height: 100vh;
            color: #ecf0f1;
            padding: 1rem;
            position: fixed;
            width: 240px;
        }
        .sidebar a {
            color: #ecf0f1;
            text-decoration: none;
            font-size: 1rem;
            padding: 0.8rem;
            display: block;
            margin-bottom: 10px;
            border-radius: 5px;
        }
        .sidebar a:hover {
            background-color: #34495e;
        }
        .sidebar .sidebar-header {
            font-size: 1.5rem;
            font-weight: bold;
            margin-bottom: 2rem;
        }
        .main-content {
            margin-left: 260px;
            padding: 2rem;
        }
        .card {
            border-radius: 15px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            transition: transform 0.2s ease-in-out;
        }
        .card:hover {
            transform: translateY(-10px);
        }
        .card i {
            font-size: 2.5rem;
            color: #fff;
        }
        .card-blue { background-color: #3498db; color: #fff; }
        .card-green { background-color: #2ecc71; color: #fff; }
        .card-yellow { background-color: #f1c40f; color: #fff; }
        .card-red { background-color: #e74c3c; color: #fff; }
        .chart-container {
            background-color: #fff;
            border-radius: 15px;
            padding: 1rem;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body>

<div class="sidebar">
    <div class="sidebar-header">Admin Dashboard</div>
    <a href="#"><i class="fas fa-home"></i> Dashboard</a>
    <a href="#"><i class="fas fa-utilisateurs"></i> utilisateurs</a>
    <a href="#"><i class="fas fa-rendez-vous"></i> rendez-vous</a>
    <a href="#"><i class="fas fa-Ressources Éducatives"></i> Ressources Éducatives</a>
    <a href="#"><i class="fas fa-consultation"></i> consultation</a>
    <a href="#"><i class="fas fa-forom"></i> forom</a>


    <a href="#"><i class="fas fa-chart-line"></i> Analytics</a>
    <a href="#"><i class="fas fa-cog"></i> Settings</a>
</div>

<div class="main-content">
    <!-- Navigation Bar -->
    <nav class="navbar navbar-header navbar-header-transparent navbar-expand-lg border-bottom">
        <div class="container-fluid">
            <nav class="navbar navbar-header-left navbar-expand-lg navbar-form nav-search p-0 d-none d-lg-flex">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <button type="submit" class="btn btn-search pe-1">
                            <i class="fa fa-search search-icon"></i>
                        </button>
                    </div>
                    <input type="text" placeholder="Search ..." class="form-control">
                </div>
            </nav>
            <ul class="navbar-nav topbar-nav ms-md-auto align-items-center">
                <li class="nav-item topbar-icon dropdown hidden-caret">
                    <a class="nav-link dropdown-toggle" href="#" id="messageDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa fa-envelope"></i>
                    </a>
                </li>
                <li class="nav-item topbar-icon dropdown hidden-caret">
                    <a class="nav-link dropdown-toggle" href="#" id="notifDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa fa-bell"></i>
                    </a>
                </li>
                <div class="row mt-4">
    <div class="col-md-12">
        <div class="chart-container">
            <h5 class="mb-3">Liste des Utilisateurs</h5>
            <table class="table table-striped table-hover shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>Prénom</th>
                        <th>Email</th>
                        <th>Date de Naissance</th>
                        <th>Sexe</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for utilisateurr in utilisateurrs %}
                        <tr>
                            <td>{{ utilisateurr.id }}</td>
                            <td>{{ utilisateurr.nom }}</td>
                            <td>{{ utilisateurr.prenom }}</td>
                            <td>{{ utilisateurr.email }}</td>
                            <td>{{ utilisateurr.dateNaissance ? utilisateurr.dateNaissance|date('Y-m-d') : 'N/A' }}</td>
                            <td>{{ utilisateurr.sexe }}</td>
                            <td>
                                <a href="{{ path('app_utilisateurr_show', {'id': utilisateurr.id}) }}" class="btn btn-info btn-sm">Voir</a>
                                <a href="{{ path('app_utilisateurr_edit', {'id': utilisateurr.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                                <a href="{{ path('app_utilisateurr_delete', {'id': utilisateurr.id}) }}" class="btn btn-danger btn-sm"
                                   onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ?');">Supprimer</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center text-muted">Aucun utilisateur trouvé.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

            </ul>
        </div>
    </nav>

    <!-- Dashboard Content -->
    <div class="header">
        <h1>Welcome to Admin Dashboard</h1>
    </div>

    <div class="row">
        <div class="col-md-3">
            <div class="card card-blue text-center p-4">
                <i class="fas fa-users"></i>
                <h3 class="mt-3">Users</h3>
                <h4>1,245</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card card-green text-center p-4">
                <i class="fas fa-dollar-sign"></i>
                <h3 class="mt-3">Sales</h3>
                <h4>$12,345</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card card-yellow text-center p-4">
                <i class="fas fa-shopping-cart"></i>
                <h3 class="mt-3">Orders</h3>
                <h4>245</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card card-red text-center p-4">
                <i class="fas fa-exclamation-triangle"></i>
                <h3 class="mt-3">Issues</h3>
                <h4>5</h4>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-8">
            <div class="chart-container">
                <h5>User Statistics</h5>
                <canvas id="userChart"></canvas>
            </div>
        </div>
        <div class="col-md-4">
            <div class="chart-container">
                <h5>Daily Sales</h5>
                <canvas id="salesChart"></canvas>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const userCtx = document.getElementById('userChart').getContext('2d');
    const userChart = new Chart(userCtx, { type: 'line', data: { labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'], datasets: [{ label: 'Users', data: [50, 75, 150, 200, 300], borderColor: '#3498db' }] } });
    const salesCtx = document.getElementById('salesChart').getContext('2d');
    const salesChart = new Chart(salesCtx, { type: 'bar', data: { labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'], datasets: [{ label: 'Sales', data: [100, 200, 150, 300, 400], backgroundColor: '#2ecc71' }] } });
</script>

</body>
</html>
