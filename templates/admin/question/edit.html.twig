{% extends 'admin/index.html.twig' %}

{% block title %}Modifier la question{% endblock %}

{% block body %}
    {{ block('sidebar') }} {# Include the sidebar block from the parent template #}

    <style>
        /* Custom CSS to reduce icon size */
        .btn i {
            font-size: 0.8rem; /* Adjust the size as needed */
        }
    </style>
    <div class="main-content">
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-lg">
                    <div class="card-header bg-primary text-white py-4">
                        <h1 class="h4 mb-0">Modifier la question</h1>
                    </div>
                    <div class="card-body p-4">
                        {# Include the form template #}
                        {{ include('question/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
                    </div>
                    <div class="card-footer bg-light py-3 d-flex justify-content-between align-items-center">
                        <a href="{{ path('app_admin_question_index') }}" class="btn btn-outline-secondary btn-sm" aria-label="Retour à la liste">
                            <i class="fas fa-arrow-left me-2"></i> Retour à la liste
                        </a>
                        {{ include('question/_delete_form.html.twig') }}
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>

{% endblock %}