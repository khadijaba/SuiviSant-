{% extends 'base.html.twig' %}

{% block title %}Questions & Réponses - Bien-Être+ Forum{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .qa-container {
        padding-top: 100px;
        min-height: 100vh;
        background-color: #f8f9fa;
    }
    .question-answer-group {
        margin-bottom: 30px;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        transition: transform 0.2s;
    }
    .question-answer-group:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }
    .question-section {
        background-color: #ffffff;
        padding: 20px;
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }
    .question-title {
        font-size: 1.4rem;
        font-weight: 600;
        margin-bottom: 10px;
        color: #333;
    }
    .question-metadata {
        display: flex;
        justify-content: space-between;
        color: #6c757d;
        font-size: 0.9rem;
        margin-bottom: 10px;
    }
    .question-category {
        display: inline-block;
        padding: 2px 8px;
        background-color: #e9f7fe;
        color: #0d6efd;
        border-radius: 50px;
        font-size: 0.8rem;
        margin-right: 10px;
    }
    .question-content {
        margin-bottom: 15px;
        color: #495057;
    }
    .answers-section {
        background-color: #f8f9fa;
        padding: 15px 20px;
    }
    .answers-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }
    .answers-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #495057;
    }
    .answer-count {
        background-color: #0d6efd;
        color: white;
        font-size: 0.9rem;
        padding: 3px 10px;
        border-radius: 50px;
    }
    .answer-preview {
        padding: 10px 15px;
        background-color: white;
        border-radius: 8px;
        margin-bottom: 10px;
        border-left: 3px solid #0d6efd;
    }
    .answer-preview.accepted {
        border-left-color: #28a745;
        background-color: #f0fff4;
    }
    .answer-author {
        font-size: 0.85rem;
        color: #6c757d;
    }
    .answer-content {
        margin-top: 5px;
        color: #495057;
        font-size: 0.95rem;
    }
    .accepted-badge {
        background-color: #28a745;
        color: white;
        font-size: 0.8rem;
        padding: 2px 8px;
        border-radius: 50px;
        margin-left: 10px;
    }
    .view-all-link {
        display: block;
        text-align: center;
        padding: 8px;
        background-color: #f1f1f1;
        color: #495057;
        text-decoration: none;
        border-radius: 0 0 10px 10px;
        font-weight: 500;
        transition: background-color 0.2s;
    }
    .view-all-link:hover {
        background-color: #e9ecef;
        color: #0d6efd;
    }
    .no-qa-message {
        text-align: center;
        padding: 40px;
        background-color: white;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }
    .section-title {
        color: #0d6efd;
        font-weight: 700;
        margin-bottom: 25px;
        border-bottom: 2px solid #f0f0f0;
        padding-bottom: 10px;
    }
    .sidebar-card {
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 20px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }
    .sidebar-header {
        background-color: #0d6efd;
        color: white;
        padding: 15px;
        font-weight: 600;
    }
    .category-filter {
        display: block;
        padding: 10px 15px;
        border-bottom: 1px solid #f1f1f1;
        color: #495057;
        text-decoration: none;
        transition: background-color 0.2s;
    }
    .category-filter:hover {
        background-color: #f8f9fa;
    }
    .category-filter.active {
        background-color: #e9f7fe;
        color: #0d6efd;
        font-weight: 500;
    }
    .category-count {
        float: right;
        background-color: #f1f1f1;
        color: #495057;
        padding: 2px 8px;
        border-radius: 50px;
        font-size: 0.8rem;
    }
    .ask-button {
        display: inline-block;
        background-color: #0d6efd;
        color: white;
        padding: 12px 25px;
        border-radius: 50px;
        font-weight: 600;
        text-decoration: none;
        transition: background-color 0.2s;
        border: none;
        margin-bottom: 20px;
    }
    .ask-button:hover {
        background-color: #0b5ed7;
        color: white;
    }
</style>
{% endblock %}

{% block body %}
<nav class="navbar navbar-expand-lg bg-light fixed-top shadow-lg">
    <div class="container">
        <!-- Mobile Brand -->
        <a class="navbar-brand mx-auto d-lg-none" href="{{ path('app_home') }}">
            Bien-Être+
            <strong class="d-block">Health and Well-being</strong>
        </a>

        <!-- Navbar Toggler for Mobile -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" 
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar Links -->
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav mx-auto">
                <li class="nav-item {% if app.request.get('_route') == 'app_home' %}active{% endif %}">
                    <a class="nav-link" href="{{ path('app_home') }}">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#about">About</a>
                </li>

                <!-- Centered Brand for Large Screens -->
                <a class="navbar-brand d-none d-lg-block" href="{{ path('app_home') }}">
                    Bien-Être+
                    <strong class="d-block">Health and Well-being</strong>
                </a>

                <li class="nav-item">
                    <a class="nav-link" href="#reviews">Experts</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#timeline">Timeline</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="qa-container">
    <div class="container py-5">
        <div class="row mb-4">
            <div class="col-md-8">
                <h1 class="section-title">
                    <i class="bi bi-chat-left-text me-2"></i>
                    Questions et Réponses
                </h1>
            </div>
            <div class="col-md-4 text-end">
                <a href="{{ path('app_question_new') }}" class="ask-button">
                    <i class="bi bi-plus-circle me-2"></i>
                    Poser une question
                </a>
            </div>
        </div>

        <div class="row">
            <!-- Main Content -->
            <div class="col-lg-8">
                {% if questionsWithAnswers|length > 0 %}
                    {% for qaItem in questionsWithAnswers %}
                        <div class="question-answer-group">
                            <!-- Question Section -->
                            <div class="question-section">
                                <h2 class="question-title">
                                    <a href="{{ path('app_question_show', {'id': qaItem.question.id}) }}" class="text-decoration-none text-dark">
                                        {{ qaItem.question.title }}
                                    </a>
                                </h2>
                                
                                <div class="question-metadata">
                                    <div>
                                        {% if qaItem.question.category %}
                                            <span class="question-category">
                                                <i class="bi bi-tag-fill me-1"></i>
                                                {{ qaItem.question.category }}
                                            </span>
                                        {% endif %}
                                        <span class="author">
                                            <i class="bi bi-person-circle me-1"></i>
                                            {{ qaItem.question.authorName }}
                                        </span>
                                    </div>
                                    <div>
                                        <span class="date">
                                            <i class="bi bi-calendar me-1"></i>
                                            {{ qaItem.question.createdAt|date('d/m/Y') }}
                                        </span>
                                        <span class="views ms-2">
                                            <i class="bi bi-eye me-1"></i>
                                            {{ qaItem.question.views }}
                                        </span>
                                    </div>
                                </div>
                                
                                <div class="question-content">
                                    {{ qaItem.question.content|striptags|length > 200 ? 
                                        qaItem.question.content|striptags|slice(0, 200) ~ '...' : 
                                        qaItem.question.content|striptags }}
                                </div>
                            </div>
                            
                            <!-- Answers Section -->
                            <div class="answers-section">
                                <div class="answers-header">
                                    <h3 class="answers-title">
                                        <i class="bi bi-chat-dots me-1"></i>
                                        Réponses
                                    </h3>
                                    <span class="answer-count">{{ qaItem.totalAnswers }}</span>
                                </div>
                                
                                {% if qaItem.hasAcceptedAnswer and qaItem.acceptedAnswer %}
                                    <!-- Accepted Answer Preview -->
                                    <div class="answer-preview accepted">
                                        <div class="d-flex justify-content-between">
                                            <div class="answer-author">
                                                <i class="bi bi-person-circle me-1"></i>
                                                {{ qaItem.acceptedAnswer.authorName }}
                                                <span class="accepted-badge">
                                                    <i class="bi bi-check-circle me-1"></i>
                                                    Acceptée
                                                </span>
                                            </div>
                                            <div class="answer-votes">
                                                <i class="bi bi-hand-thumbs-up me-1"></i>
                                                {{ qaItem.acceptedAnswer.votes }}
                                            </div>
                                        </div>
                                        <div class="answer-content">
                                            {{ qaItem.acceptedAnswer.content|striptags|length > 150 ? 
                                                qaItem.acceptedAnswer.content|striptags|slice(0, 150) ~ '...' : 
                                                qaItem.acceptedAnswer.content|striptags }}
                                        </div>
                                    </div>
                                    
                                    {% if qaItem.totalAnswers > 1 %}
                                        <!-- One More Answer Preview -->
                                        {% set otherAnswer = null %}
                                        {% for answer in qaItem.answers %}
                                            {% if not answer.isIsAccepted() %}
                                                {% set otherAnswer = answer %}
                                                {% break %}
                                            {% endif %}
                                        {% endfor %}
                                        
                                        {% if otherAnswer %}
                                            <div class="answer-preview">
                                                <div class="d-flex justify-content-between">
                                                    <div class="answer-author">
                                                        <i class="bi bi-person-circle me-1"></i>
                                                        {{ otherAnswer.authorName }}
                                                    </div>
                                                    <div class="answer-votes">
                                                        <i class="bi bi-hand-thumbs-up me-1"></i>
                                                        {{ otherAnswer.votes }}
                                                    </div>
                                                </div>
                                                <