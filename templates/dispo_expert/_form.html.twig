{% extends 'base.html.twig' %}

{% block title %}Manage Dispo Expert{% endblock %}

{% block body %}
    <style>
        body {
            font-family: 'Roboto', sans-serif;
            background-color: #f4f6f9;
            margin: 0;
            padding: 0;
        }

        .sidebar {
            background-color: #2c3e50;
            color: #ecf0f1;
            position: fixed;
            top: 0;
            left: 0;
            width: 240px;
            height: 100vh;
            padding: 1rem;
            overflow-y: auto;
        }

        .sidebar a {
            color: #ecf0f1;
            text-decoration: none;
            font-size: 1rem;
            padding: 0.8rem;
            display: block;
            margin-bottom: 10px;
            border-radius: 5px;
        }

        .sidebar a:hover {
            background-color: #34495e;
        }

        .sidebar .sidebar-header {
            font-size: 1.5rem;
            font-weight: bold;
            margin-bottom: 2rem;
            text-align: center;
        }

        .main-content {
            margin-left: 240px;
            padding: 20px;
            width: calc(100% - 240px);
        }

        .navbar {
            margin-left: 50px;
            width: calc(100% - 240px);
            padding: 10px;
            margin-bottom: 0;
        }

        .container {
            margin-left: 50px;
            max-width: 800px;
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
        }

        .form-errors {
            color: red;
            font-size: 0.875rem;
        }
    </style>

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">Admin Dashboard</div>
        <a href="{{ path('dashboard') }}"><i class="fas fa-home"></i> Dashboard</a>
        <a href="{{ path('app_dispo_expert_index') }}"><i class="fas fa-users"></i> Disponibilité Expert</a>
        <a href="{{ path('app_rendez_vous_index') }}"><i class="fas fa-calendar"></i> Rendez-vous</a>
        <a href="#"><i class="fas fa-book"></i> Ressources Éducatives</a>
        <a href="#"><i class="fas fa-comments"></i> Consultation</a>
        <a href="#"><i class="fas fa-chart-line"></i> Analytics</a>
        <a href="#"><i class="fas fa-cog"></i> Settings</a>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
            <div class="container-fluid">
                <form class="d-flex">
                    <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search">
                    <button class="btn btn-outline-success" type="submit"><i class="fa fa-search"></i></button>
                </form>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="fa fa-envelope"></i></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="fa fa-bell"></i></a>
                    </li>
                </ul>
            </div>
        </nav>

        <div class="container mt-4">
            <h1 class="mb-4">Add Dispo Expert</h1>

            {{ form_start(form, { 'attr': {'class': 'dispoexpert-form'} }) }}

                <div class="mb-3">
                    {{ form_label(form.expert, 'Expert', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.expert, { 'attr': {'class': 'form-control'} }) }}
                    <div class="form-errors">
                        {{ form_errors(form.expert) }}
                    </div>
                </div>

                <div class="mb-3">
                    {{ form_label(form.date, 'Date', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.date, { 'attr': {'class': 'form-control', 'min': ''} }) }}
                    <div class="form-errors">
                        {{ form_errors(form.date) }}
                    </div>
                </div>

                <div class="mb-3">
                    {{ form_label(form.time, 'Time', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.time, { 'attr': {'class': 'form-control'} }) }}
                    <div class="form-errors">
                        {{ form_errors(form.time) }}
                    </div>
                </div>

                <div class="mb-3">
                    {{ form_label(form.location, 'Location', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.location, { 'attr': {'class': 'form-control', 'placeholder': 'Enter location'} }) }}
                    <div class="form-errors">
                        {{ form_errors(form.location) }}
                    </div>
                </div>

                <div class="mb-3 form-check">
                    {{ form_widget(form.status, { 'attr': {'class': 'form-check-input'} }) }}
                    {{ form_label(form.status, 'Available', {'label_attr': {'class': 'form-check-label ms-2'}}) }}
                    <div class="form-errors">
                        {{ form_errors(form.status) }}
                    </div>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">{{ button_label|default('Save') }}</button>
                </div>

            {{ form_end(form) }}
        </div>
    </div>

{% endblock %}

{% block script %}
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.querySelector('.dispoexpert-form');
        const dateField = document.querySelector('input[name="dispo_expert[date]"]');
        const timeField = document.querySelector('input[name="dispo_expert[time]"]');

        // Set minimum selectable date to today
        let today = new Date().toISOString().split('T')[0];
        dateField.setAttribute("min", today);

        // Prevent selecting past times when today is selected
        dateField.addEventListener("change", function () {
            let selectedDate = new Date(this.value);
            let now = new Date();
            if (selectedDate.toDateString() === now.toDateString()) {
                timeField.setAttribute("min", now.toTimeString().split(' ')[0].slice(0, 5));
            } else {
                timeField.removeAttribute("min");
            }
        });

        form.addEventListener('submit', function(event) {
            let isValid = true;
            let locationField = document.querySelector('input[name="dispo_expert[location]"]');
            let expertField = document.querySelector('select[name="dispo_expert[expert]"]');

            if (!locationField.value || locationField.value.length < 3) {
                isValid = false;
                alert('Location must be at least 3 characters long.');
            }

            if (!expertField.value) {
                isValid = false;
                alert('Please select an expert.');
            }

            if (!isValid) {
                event.preventDefault();
            }
        });
    });
</script>
{% endblock %}
