{% extends 'base.html.twig' %}

{% block title %}Dispo Expert Details{% endblock %}

{% block body %}
    <style>
        .sidebar {
            background-color: #2c3e50;
            color: #ecf0f1;
            position: fixed;
            top: 0;
            left: 0;
            width: 240px;
            height: 100vh;
            padding: 1rem;
            overflow-y: auto;
        }

        .sidebar a {
            color: #ecf0f1;
            text-decoration: none;
            font-size: 1rem;
            padding: 0.8rem;
            display: block;
            margin-bottom: 10px;
            border-radius: 5px;
        }

        .sidebar a:hover, .sidebar a.active {
            background-color: #34495e;
        }

        .sidebar .sidebar-header {
            font-size: 1.5rem;
            font-weight: bold;
            margin-bottom: 2rem;
            text-align: center;
        }

        .main-content {
            margin-left: 240px;
            padding: 20px;
            width: calc(100% - 240px);
        }

        .navbar {
            margin-left: 240px;
            width: calc(100% - 240px);
        }

        .table th {
            width: 30%;
        }
    </style>

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">Admin Dashboard</div>
        <a href="{{ path('dashboard') }}"><i class="fas fa-home"></i> Dashboard</a>
        <a href="{{ path('app_dispo_expert_index') }}" class="active"><i class="fas fa-users"></i> Disponibilité Expert</a>
        <a href="{{ path('app_rendez_vous_index') }}"><i class="fas fa-calendar"></i> Rendez-vous</a>
        <a href="#"><i class="fas fa-book"></i> Ressources Éducatives</a>
        <a href="#"><i class="fas fa-comments"></i> Consultation</a>
        <a href="#"><i class="fas fa-chart-line"></i> Analytics</a>
        <a href="#"><i class="fas fa-cog"></i> Settings</a>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Navigation Bar -->
        <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
            <div class="container-fluid">
                <form class="d-flex">
                    <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search">
                    <button class="btn btn-outline-success" type="submit"><i class="fa fa-search"></i></button>
                </form>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="fa fa-envelope"></i></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="fa fa-bell"></i></a>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Dispo Expert Details -->
        <div class="container mt-4">
            <h1 class="mb-4">Dispo Expert Details</h1>

            <table class="table table-bordered">
                <tr>
                    <th>ID</th>
                    <td>{{ dispo_expert.id }}</td>
                </tr>
                <tr>
                    <th>Date</th>
                    <td>{{ dispo_expert.date|date('Y-m-d') }}</td>
                </tr>
                <tr>
                    <th>Time</th>
                    <td>{{ dispo_expert.time|date('H:i') }}</td>
                </tr>
                <tr>
                    <th>Status</th>
                    <td>
                        <span class="badge {{ dispo_expert.status ? 'bg-success' : 'bg-danger' }}">
                            {{ dispo_expert.status ? 'Available' : 'Unavailable' }}
                        </span>
                    </td>
                </tr>
                <tr>
                    <th>Location</th>
                    <td>{{ dispo_expert.location }}</td>
                </tr>
                <tr>
                    <th>Expert</th>
                    <td>
                        <strong>{{ dispo_expert.expert.name }}</strong><br>
                        <span class="text-muted">{{ dispo_expert.expert.specialite }}</span>
                    </td>
                </tr>
                <tr>
                    <th>Rendezvous</th>
                    <td>
                        {% if dispo_expert.rendezVous %}
                            <a href="{{ path('app_rendez_vous_show', {'id': dispo_expert.rendezVous.id}) }}" class="btn btn-info btn-sm">
                                View Rendezvous
                            </a>
                        {% else %}
                            <span class="text-muted">No rendezvous assigned</span>
                        {% endif %}
                    </td>
                </tr>
            </table>

            <a href="{{ path('app_dispo_expert_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to list
            </a>
            <a href="{{ path('app_dispo_expert_edit', {'id': dispo_expert.id}) }}" class="btn btn-primary">
                <i class="fas fa-edit"></i> Edit
            </a>
            {{ include('dispo_expert/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
