{% extends 'base_patient.html.twig' %}

{% block title %}Mes Consultations{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-4">Mes Consultations</h1>
        </div>
    </div>

    <div class="row">
        <div class="col">
            <div class="card shadow">
                <div class="card-body">
                    {% if consultations is empty %}
                        <div class="text-center py-5">
                            <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                            <p class="lead text-muted">Vous n'avez pas encore de consultations.</p>
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Description</th>
                                        <th>Statut du Rapport</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for consultation in consultations %}
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <i class="fas fa-calendar-alt text-primary me-2"></i>
                                                    {{ consultation.dateConsultation|date('d/m/Y H:i') }}
                                                </div>
                                            </td>
                                            <td>
                                                <div class="text-wrap" style="max-width: 300px;">
                                                    {{ consultation.description|slice(0, 100) }}
                                                    {% if consultation.description|length > 100 %}...{% endif %}
                                                </div>
                                            </td>
                                            <td>
                                                {% if consultation.rapport %}
                                                    <span class="badge bg-success">
                                                        <i class="fas fa-file-medical me-1"></i>
                                                        Rapport disponible
                                                    </span>
                                                {% else %}
                                                    <span class="badge bg-warning text-dark">
                                                        <i class="fas fa-clock me-1"></i>
                                                        En attente
                                                    </span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <a href="{{ path('front_consultation_show', {'id': consultation.id}) }}" 
                                                   class="btn btn-outline-primary btn-sm">
                                                    <i class="fas fa-eye me-1"></i>
                                                    Voir les détails
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .table th {
        font-weight: 600;
    }
    .badge {
        font-weight: 500;
        padding: 0.5em 0.8em;
    }
    .btn-sm {
        padding: 0.4rem 0.8rem;
    }
</style>
{% endblock %} 