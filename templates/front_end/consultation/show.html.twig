{% extends 'base_patient.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/espace-patient.css') }}">
{% endblock %}

{% block title %}Détails de la Consultation{% endblock %}

{% block body %}
<div class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-4">Détails de la Consultation</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a href="{{ path('front_consultation_index') }}" class="text-white">
                                <i class="fas fa-arrow-left me-1"></i>
                                Retour à mon espace
                            </a>
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="container fade-in">
    <div class="row">
        <div class="col-md-6">
            <!-- Détails de la consultation -->
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-calendar-check text-primary me-2"></i>
                        <h3 class="h4 mb-0">Informations de la Consultation</h3>
                    </div>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Date</dt>
                        <dd class="col-sm-8">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-calendar-alt text-primary me-2"></i>
                                {{ consultation.dateConsultation|date('d/m/Y H:i') }}
                            </div>
                        </dd>

                        <dt class="col-sm-4">Patient</dt>
                        <dd class="col-sm-8">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-user text-primary me-2"></i>
                                {{ consultation.utilisateur.prenom }} {{ consultation.utilisateur.nom }}
                            </div>
                        </dd>

                        <dt class="col-sm-4">Description</dt>
                        <dd class="col-sm-8">
                            <div class="text-wrap">
                                {{ consultation.description }}
                            </div>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <!-- Rapport de consultation -->
            <div class="card shadow-sm">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-file-medical text-primary me-2"></i>
                            <h3 class="h4 mb-0">Rapport de Consultation</h3>
                        </div>
                        {% if consultation.rapport %}
                            <span class="badge bg-success">
                                <i class="fas fa-check-circle me-1"></i>
                                Disponible
                            </span>
                        {% else %}
                            <span class="badge bg-warning">
                                <i class="fas fa-clock me-1"></i>
                                En attente
                            </span>
                        {% endif %}
                    </div>
                </div>
                <div class="card-body">
                    {% if consultation.rapport %}
                        <dl class="row">
                            <dt class="col-sm-4">Date du rapport</dt>
                            <dd class="col-sm-8">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-calendar-alt text-primary me-2"></i>
                                    {{ consultation.rapport.date|date('d/m/Y') }}
                                </div>
                            </dd>

                            <dt class="col-sm-4">Description</dt>
                            <dd class="col-sm-8">{{ consultation.rapport.description }}</dd>

                            <dt class="col-12 mb-3">Contenu du rapport</dt>
                            <dd class="col-12">
                                <div class="p-4 bg-light rounded">
                                    {{ consultation.rapport.contenu|nl2br }}
                                </div>
                            </dd>
                        </dl>
                    {% else %}
                        <div class="empty-state">
                            <i class="fas fa-clock"></i>
                            <p class="lead">Le rapport n'est pas encore disponible.</p>
                            <p class="text-muted">Vous serez notifié dès que le rapport sera prêt.</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 