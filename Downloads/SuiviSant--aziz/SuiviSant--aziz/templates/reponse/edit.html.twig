{% extends 'base.html.twig' %}

{% block title %}Modifier la réponse{% endblock %}

{% block body %}
    {{ block('header') }} {# Inclure le bloc header du template parent #}

    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-lg">
                    <div class="card-header bg-primary text-white py-4">
                        <h1 class="h4 mb-0">Modifier la réponse</h1>
                    </div>
                    <div class="card-body p-4">
                        {{ include('reponse/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
                    </div>
                    <div class="card-footer bg-light py-3 d-flex justify-content-between align-items-center">
                        <a href="{{ path('app_reponse_index') }}" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-arrow-left me-2"></i> Retour à la liste
                        </a>
                        {{ include('reponse/_delete_form.html.twig') }}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{ block('footer') }} {# Inclure le bloc footer du template parent #}
{% endblock %}