{% extends 'base.html.twig' %}

{% block title %}Questions{% endblock %}

{% block body %}
    {{ block('header') }} {# Inclure le bloc header du template parent #}

    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="h3 mb-0">Questions</h1>
                    <a href="{{ path('app_question_new') }}" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus me-2"></i> Poser une question
                    </a>
                </div>

                {% if questions is empty %}
                    <div class="alert alert-info" role="alert">
                        Aucune question trouvée. Soyez le premier à en poser une !
                    </div>
                {% else %}
                    {% for question in questions %}
                        <div class="card shadow-sm mb-4">
                            <div class="card-body">
                                <h5 class="card-title">{{ question.body }}</h5>
                                <p class="card-text text-muted small">
                                    Posée par <strong>Utilisateur {{ question.ownerid }}</strong> le {{ question.datecreation ? question.datecreation|date('d/m/Y') : '' }}
                                </p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <a href="{{ path('app_reponse_new', {'questionId': question.id}) }}" class="btn btn-sm btn-outline-success">
                                        <i class="fas fa-reply me-1"></i> Répondre
                                    </a>
                                    <div>
                                        <a href="{{ path('app_question_show', {'id': question.id}) }}" class="btn btn-sm btn-outline-primary me-2">
                                            <i class="fas fa-eye me-1"></i> Voir
                                        </a>
                                        <a href="{{ path('app_question_edit', {'id': question.id}) }}" class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-edit me-1"></i> Modifier
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </div>

    {{ block('footer') }} {# Inclure le bloc footer du template parent #}
{% endblock %}